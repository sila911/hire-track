# Laravel API base URL for Axios.
# Dev: use /api so Vite proxies requests to BACKEND_URL (see vite.config.js).
# Prod (SPA on another host): e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Target for the Vite dev proxy (not exposed to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Supabase configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
